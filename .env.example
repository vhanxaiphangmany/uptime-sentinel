# Copy to .env (or pass as container env vars) — do not commit real secrets.
HOST=0.0.0.0
PORT=8080
DB_PATH=./data/sentinel.db

# Comma-separated seed targets, only used when the DB is empty
SEED_TARGETS=API=https://api.example.com/healthz,Website=https://example.com

# REQUIRED in production for mutating API routes (>= 8 chars)
ADMIN_TOKEN=change-me-to-a-long-secret

PROBE_CONCURRENCY=8
FAILURE_THRESHOLD=3
DEFAULT_TIMEOUT_MS=5000
DEFAULT_INTERVAL_SECONDS=60
RETENTION_DAYS=14
SLO_TARGET=0.999
LOG_LEVEL=info
APP_VERSION=dev
NODE_ENV=development
