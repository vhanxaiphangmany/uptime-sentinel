{
  "name": "uptime-sentinel",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-dependency uptime monitor with a production-grade delivery pipeline (CI/CD, Docker, Kubernetes, Helm, SLO alerting)",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "test": "node --test \"test/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  },
  "keywords": [
    "devops",
    "observability",
    "sre",
    "slo",
    "prometheus",
    "kubernetes",
    "uptime-monitor"
  ]
}
